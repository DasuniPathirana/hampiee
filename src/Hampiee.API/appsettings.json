{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=5432;Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true",
    "Redis": "${REDIS_CONNECTION}"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "https://hampiee.com",
    "Audience": "https://hampiee.com",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "PayHere": {
    "MerchantId": "${PAYHERE_MERCHANT_ID}",
    "MerchantSecret": "${PAYHERE_MERCHANT_SECRET}",
    "Sandbox": false
  },
  "SendGrid": {
    "ApiKey": "${SENDGRID_API_KEY}",
    "FromEmail": "noreply@hampiee.com",
    "FromName": "Hampiee"
  },
  "Storage": {
    "Provider": "GCS",
    "BucketName": "${GCS_BUCKET}",
    "BaseUrl": "https://storage.googleapis.com/${GCS_BUCKET}"
  },
  "Cors": {
    "Origins": [
      "https://hampiee.com",
      "https://www.hampiee.com"
    ]
  },
  "AdminEmail": "${ADMIN_EMAIL}",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "hampiee.com,www.hampiee.com,*.run.app"
}
